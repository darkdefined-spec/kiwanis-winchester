---
layout: base.njk
title: "Contact Us"
description: "Get in touch with the Kiwanis Club of Winchester, Virginia. We'd love to hear from you."
canonical: /contact/
navActive: contact
---

  <div class="page-hero" style="--page-hero-image:url('{{ cms.contact.hero.image }}'); --page-hero-position:{{ cms.contact.hero.position }};">
    <div class="kw-container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span style="color:rgba(255,255,255,0.9);">Contact</span>
      </nav>
      <h1>{{ cms.contact.hero.title }}</h1>
      <p class="hero-sub">{{ cms.contact.hero.subtitle | markdownInline | safe }}</p>
    </div>
  </div>

  <!-- ── CONTACT CARDS ── -->
  <section class="section" aria-labelledby="contact-heading">
    <div class="kw-container">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 reveal" style="margin-bottom:80px;">

        <!-- Email -->
        <div class="contact-card">
          <div class="contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <h3 style="font-size:1rem; margin-bottom:10px;">Email Us</h3>
          <p style="font-size:0.875rem; color:var(--kw-muted); line-height:1.65; margin-bottom:20px;">For general inquiries, volunteering interest, community support requests, donation questions, or program information.</p>
          <a href="mailto:sec@winvakiw.org" class="btn btn-primary btn-sm">sec@winvakiw.org</a>
          <p style="font-size:0.8rem; color:var(--kw-muted); margin-top:12px;">For membership: <a href="mailto:pres@winvakiw.org" style="color:var(--kw-blue); font-weight:600;">pres@winvakiw.org</a></p>
        </div>

        <!-- Address -->
        <div class="contact-card reveal reveal-d1">
          <div class="contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3 style="font-size:1rem; margin-bottom:10px;">Mailing Address</h3>
          <p style="font-size:0.875rem; color:var(--kw-muted); line-height:1.65; margin-bottom:20px;">
            Winchester Kiwanis<br>P.O. Box 2591<br>Winchester, VA 22604
          </p>
          <div style="background:var(--kw-blue-light); border-radius:10px; padding:14px 16px; font-size:0.85rem; color:var(--kw-navy); line-height:1.6;">
            <strong>Weekly Meetings:</strong><br>Wednesdays at noon<br>Winchester Moose Club<br>215 E. Cork St., Winchester, VA
          </div>
        </div>

        <!-- Facebook -->
        <div class="contact-card reveal reveal-d2">
          <div class="contact-icon" style="background:rgba(24,119,242,0.1); color:#1877F2;">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </div>
          <h3 style="font-size:1rem; margin-bottom:10px;">Follow on Facebook</h3>
          <p style="font-size:0.875rem; color:var(--kw-muted); line-height:1.65; margin-bottom:20px;">Stay up to date with events, photos, announcements, and the latest news from the club.</p>
          <a href="https://www.facebook.com/winkiwanis" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm" style="background:#1877F2;">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            @winkiwanis
          </a>
        </div>
      </div>

      <!-- Leadership Team -->
      <div class="reveal" style="margin-bottom:0;">
        <h2 id="contact-heading" style="font-size:clamp(1.4rem,3vw,2rem); margin-bottom:32px; text-align:center;">Club Leadership Team</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-3xl mx-auto">
          <div class="lead-card">
            <div class="lead-avatar" aria-hidden="true">MD</div>
            <h3 style="font-size:1.05rem; margin-bottom:2px;">Mike Didawick</h3>
            <p class="role" style="margin-bottom:10px;">Club President</p>
            <a href="mailto:pres@winvakiw.org" style="font-size:0.825rem; color:var(--kw-blue); text-decoration:none; font-weight:600;">pres@winvakiw.org</a>
          </div>
          <div class="lead-card">
            <div class="lead-avatar" aria-hidden="true">RT</div>
            <h3 style="font-size:1.05rem; margin-bottom:2px;">Ryan Taylor</h3>
            <p class="role">Public Relations Chair</p>
            <p style="font-size:0.8rem; color:var(--kw-muted); margin-top:6px;">Website, Facebook &amp; Newsletters</p>
          </div>
          <div class="lead-card">
            <div class="lead-avatar" aria-hidden="true">BD</div>
            <h3 style="font-size:1.05rem; margin-bottom:2px;">Brenda Dodd</h3>
            <p class="role" style="margin-bottom:10px;">Secretary</p>
            <a href="mailto:sec@winvakiw.org" style="font-size:0.825rem; color:var(--kw-blue); text-decoration:none; font-weight:600;">sec@winvakiw.org</a>
          </div>
        </div>
        <p style="max-width:660px; margin:26px auto 0; text-align:center; color:var(--kw-muted); line-height:1.7; font-size:0.92rem;">
          Full officer, board, and committee chair rosters can be added to the site after the club confirms which roles should be listed publicly. For current governance or committee questions, contact the secretary.
        </p>
      </div>
    </div>
  </section>

  <!-- ── CONTACT FORM ── -->
  <section class="section bg-light" aria-labelledby="form-heading">
    <div class="kw-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14">

        <!-- Form -->
        <div class="reveal">
          <span class="tag tag-blue" style="margin-bottom:16px; display:inline-flex;">Send a Message</span>
          <h2 id="form-heading" class="section-title">{{ cms.contact.form.title }}</h2>
          <p style="color:var(--kw-muted); line-height:1.7; margin-bottom:32px;">{{ cms.contact.form.intro | markdownInline | safe }} <a href="mailto:sec@winvakiw.org" style="color:var(--kw-blue); font-weight:600;">sec@winvakiw.org</a>.</p>

          <form id="contact-form" novalidate aria-label="Contact form">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5" style="margin-bottom:20px;">
              <div class="form-group" style="margin-bottom:0;">
                <label class="form-label" for="first-name">First Name <span style="color:#DC2626;" aria-label="required">*</span></label>
                <input type="text" id="first-name" name="first_name" class="form-input" autocomplete="given-name" required>
              </div>
              <div class="form-group" style="margin-bottom:0;">
                <label class="form-label" for="last-name">Last Name <span style="color:#DC2626;" aria-label="required">*</span></label>
                <input type="text" id="last-name" name="last_name" class="form-input" autocomplete="family-name" required>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label" for="email">Email Address <span style="color:#DC2626;" aria-label="required">*</span></label>
              <input type="email" id="email" name="email" class="form-input" autocomplete="email" required>
            </div>

            <div class="form-group">
              <label class="form-label" for="subject">Subject</label>
              <input type="text" id="subject" name="subject" class="form-input" placeholder="e.g., Membership, grant request, donation, program info">
            </div>

            <div class="form-group">
              <label class="form-label" for="message">Message <span style="color:#DC2626;" aria-label="required">*</span></label>
              <textarea id="message" name="message" class="form-textarea" placeholder="How can we help you?" required></textarea>
            </div>

            <div class="form-group">
              <label class="form-label">I'm interested in…</label>
              <div style="display:flex; flex-direction:column; gap:10px; margin-top:4px;">
                <label style="display:flex; align-items:center; gap:10px; cursor:pointer; font-size:0.9rem; color:var(--kw-body);">
                  <input type="checkbox" name="interest" value="membership" style="width:17px; height:17px; accent-color:var(--kw-blue);">
                  Becoming a Kiwanis member
                </label>
                <label style="display:flex; align-items:center; gap:10px; cursor:pointer; font-size:0.9rem; color:var(--kw-body);">
                  <input type="checkbox" name="interest" value="volunteer" style="width:17px; height:17px; accent-color:var(--kw-blue);">
                  Volunteering for an event
                </label>
                <label style="display:flex; align-items:center; gap:10px; cursor:pointer; font-size:0.9rem; color:var(--kw-body);">
                  <input type="checkbox" name="interest" value="support" style="width:17px; height:17px; accent-color:var(--kw-blue);">
                  Community support or grant request
                </label>
                <label style="display:flex; align-items:center; gap:10px; cursor:pointer; font-size:0.9rem; color:var(--kw-body);">
                  <input type="checkbox" name="interest" value="youth" style="width:17px; height:17px; accent-color:var(--kw-blue);">
                  Youth programs (K Clubs, Key Club)
                </label>
                <label style="display:flex; align-items:center; gap:10px; cursor:pointer; font-size:0.9rem; color:var(--kw-body);">
                  <input type="checkbox" name="interest" value="other" style="width:17px; height:17px; accent-color:var(--kw-blue);">
                  Something else
                </label>
              </div>
            </div>

            <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center; padding:16px;">
              Send Message
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            </button>

            <div id="form-status" class="form-status" role="status" aria-live="polite" hidden></div>
            <p style="font-size:0.8rem; color:var(--kw-muted); text-align:center; margin-top:12px;">This static form opens your email client with the message pre-filled. You can also email us directly at <a href="mailto:sec@winvakiw.org" style="color:var(--kw-blue);">sec@winvakiw.org</a>.</p>
          </form>
        </div>

        <!-- Sidebar Info -->
        <div class="reveal reveal-d2">
          <div style="background:var(--kw-navy); border-radius:20px; padding:40px; color:white; margin-bottom:20px;">
            <h3 style="color:white; font-size:1.15rem; margin-bottom:24px;">Quick Info</h3>

            <div style="display:flex; flex-direction:column; gap:20px;">
              <div style="display:flex; gap:14px; align-items:flex-start;">
                <div style="width:40px; height:40px; background:rgba(255,255,255,0.1); border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:var(--kw-gold);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <div>
                  <p style="font-family:var(--font-display); font-weight:700; color:rgba(255,255,255,0.9); font-size:0.9rem; margin-bottom:4px;">Meetings</p>
                  <p style="color:rgba(255,255,255,0.65); font-size:0.875rem; line-height:1.6;">Every Wednesday at noon<br>Guests always welcome</p>
                </div>
              </div>

              <div style="display:flex; gap:14px; align-items:flex-start;">
                <div style="width:40px; height:40px; background:rgba(255,255,255,0.1); border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:var(--kw-gold);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                  <p style="font-family:var(--font-display); font-weight:700; color:rgba(255,255,255,0.9); font-size:0.9rem; margin-bottom:4px;">Location</p>
                  <p style="color:rgba(255,255,255,0.65); font-size:0.875rem; line-height:1.6;">Winchester Moose Club<br>215 E. Cork St.<br>Winchester, VA 22601</p>
                </div>
              </div>

              <div style="display:flex; gap:14px; align-items:flex-start;">
                <div style="width:40px; height:40px; background:rgba(255,255,255,0.1); border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:var(--kw-gold);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                </div>
                <div>
                  <p style="font-family:var(--font-display); font-weight:700; color:rgba(255,255,255,0.9); font-size:0.9rem; margin-bottom:4px;">Email</p>
                  <a href="mailto:sec@winvakiw.org" style="color:var(--kw-gold); font-size:0.875rem; text-decoration:none; transition:opacity 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">sec@winvakiw.org</a>
                </div>
              </div>

              <div style="display:flex; gap:14px; align-items:flex-start;">
                <div style="width:40px; height:40px; background:rgba(255,255,255,0.1); border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:var(--kw-gold);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </div>
                <div>
                  <p style="font-family:var(--font-display); font-weight:700; color:rgba(255,255,255,0.9); font-size:0.9rem; margin-bottom:4px;">Facebook</p>
                  <a href="https://www.facebook.com/winkiwanis" target="_blank" rel="noopener noreferrer" style="color:var(--kw-gold); font-size:0.875rem; text-decoration:none;">@winkiwanis</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Join CTA card -->
          <div style="background:var(--kw-blue-light); border-radius:16px; padding:28px; border:1px solid rgba(0,61,165,0.15);">
            <h3 style="font-size:1rem; margin-bottom:10px; color:var(--kw-navy);">Interested in Joining?</h3>
            <p style="font-size:0.875rem; color:var(--kw-muted); line-height:1.65; margin-bottom:16px;">Reach out directly to our president to learn more about becoming a Kiwanis member.</p>
            <a href="mailto:pres@winvakiw.org" class="btn btn-primary btn-sm">Email President Didawick</a>
          </div>
        </div>
      </div>
    </div>
  </section>

{% block pageScripts %}
<script>
  const contactForm = document.getElementById('contact-form');
  const formStatus = document.getElementById('form-status');
  contactForm?.addEventListener('submit', event => {
    event.preventDefault();

    const firstName = document.getElementById('first-name');
    const lastName = document.getElementById('last-name');
    const email = document.getElementById('email');
    const subject = document.getElementById('subject');
    const message = document.getElementById('message');
    const requiredFields = [firstName, lastName, email, message];
    const missing = requiredFields.filter(field => !field.value.trim() || !field.checkValidity());

    requiredFields.forEach(field => field.classList.toggle('is-invalid', missing.includes(field)));

    if (missing.length) {
      formStatus.hidden = false;
      formStatus.className = 'form-status form-status-error';
      formStatus.textContent = 'Please fill out the required fields with a valid email address.';
      missing[0].focus();
      return;
    }

    const interests = Array.from(contactForm.querySelectorAll('input[name="interest"]:checked'))
      .map(input => input.parentElement.textContent.trim())
      .join(', ') || 'Not specified';
    const cleanSubject = subject.value.trim() || 'Kiwanis website inquiry';
    const body = [
      `Name: ${firstName.value.trim()} ${lastName.value.trim()}`,
      `Email: ${email.value.trim()}`,
      `Interest: ${interests}`,
      '',
      message.value.trim()
    ].join('\n');

    formStatus.hidden = false;
    formStatus.className = 'form-status form-status-success';
    formStatus.textContent = 'Your email app should open with the message ready to send.';
    window.location.href = `mailto:sec@winvakiw.org?subject=${encodeURIComponent(cleanSubject)}&body=${encodeURIComponent(body)}`;
  });
</script>
{% endblock %}
