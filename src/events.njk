---
layout: base.njk
title: "Events & Newsletters"
description: "Recent events and newsletter archive for the Kiwanis Club of Winchester, Virginia. Browse photos and download past newsletters."
canonical: /events/
navActive: events
---

  <div class="page-hero" style="--page-hero-image:url('{{ cms.events.hero.image }}'); --page-hero-position:{{ cms.events.hero.position }};">
    <div class="kw-container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span style="color:rgba(255,255,255,0.9);">Events &amp; Newsletters</span>
      </nav>
      <h1>{{ cms.events.hero.title }}</h1>
      <p class="hero-sub">{{ cms.events.hero.subtitle | markdownInline | safe }}</p>
    </div>
  </div>

  <!-- Tab Navigation -->
  <div style="background:white; border-bottom:2px solid var(--kw-border); position:sticky; top:var(--nav-h); z-index:40;">
    <div class="kw-container" style="display:flex; gap:0;">
      <a href="#recent-events" class="tab-link" style="font-family:var(--font-display); font-weight:600; font-size:0.9rem; padding:18px 24px; color:var(--kw-blue); border-bottom:2px solid var(--kw-blue); margin-bottom:-2px; text-decoration:none;">Recent Events</a>
      <a href="#newsletters" class="tab-link" style="font-family:var(--font-display); font-weight:600; font-size:0.9rem; padding:18px 24px; color:var(--kw-muted); text-decoration:none; transition:color 0.2s;" onmouseover="this.style.color='var(--kw-blue)'" onmouseout="this.style.color='var(--kw-muted)'">Newsletters</a>
    </div>
  </div>

  <!-- ── RECENT EVENTS ── -->
  <section id="recent-events" class="section" aria-labelledby="events-heading">
    <div class="kw-container">
      <div class="reveal" style="margin-bottom:40px;">
        <span class="tag tag-blue" style="margin-bottom:12px; display:inline-flex;">Photos</span>
        <h2 id="events-heading" class="section-title">{{ cms.events.eventsSection.title }}</h2>
        <p style="color:var(--kw-muted); max-width:560px; line-height:1.7;">{{ cms.events.eventsSection.intro | markdownInline | safe }}</p>
      </div>

      {% for event in collections.events %}
      <div class="event-card reveal" style="margin-bottom:24px;">
        <div class="event-card-header event-card-header--{{ event.data.headerColor | default('blue') }}">
          <div>
            <span class="event-card-eyebrow">{{ event.data.category }}</span>
            <h3 class="event-card-title">{{ event.data.title }}</h3>
            <p class="event-card-meta">{{ event.data.eventMeta }}</p>
          </div>
          {% if event.data.facebookUrl %}
          <a href="{{ event.data.facebookUrl }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">More on Facebook</a>
          {% endif %}
        </div>
        {% if event.data.photos and event.data.photos.length > 0 %}
        <div class="event-card-photos event-card-photos--{{ event.data.photos.length }}">
          {% for photo in event.data.photos %}
          <div class="event-photo">
            <img src="{{ photo.src }}" alt="{{ photo.alt }}" loading="lazy"{% if photo.objectPosition %} style="object-position:{{ photo.objectPosition }};"{% endif %}>
          </div>
          {% endfor %}
        </div>
        {% endif %}
      </div>
      {% endfor %}

      <!-- Facebook CTA -->
      <div class="reveal" style="background:var(--kw-blue-light); border-radius:16px; padding:32px; display:flex; gap:16px; align-items:center; flex-wrap:wrap; justify-content:space-between;">
        <div style="display:flex; gap:14px; align-items:center;">
          <div style="width:48px; height:48px; background:var(--kw-blue); border-radius:12px; display:flex; align-items:center; justify-content:center; color:white; flex-shrink:0;">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </div>
          <div>
            <p style="font-family:var(--font-display); font-weight:700; color:var(--kw-navy); margin-bottom:3px;">See More Photos on Facebook</p>
            <p style="font-size:0.875rem; color:var(--kw-muted);">Follow {{ site.facebookHandle }} for the latest event photos and club updates</p>
          </div>
        </div>
        <a href="{{ site.facebook }}" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Visit Our Facebook Page</a>
      </div>
    </div>
  </section>

  <!-- ── NEWSLETTERS ── -->
  <section id="newsletters" class="section bg-light" aria-labelledby="newsletters-heading">
    <div class="kw-container">
      <div class="reveal" style="margin-bottom:48px;">
        <span class="tag tag-blue" style="margin-bottom:12px; display:inline-flex;">Archive</span>
        <h2 id="newsletters-heading" class="section-title">{{ cms.events.newslettersSection.title }}</h2>
        <p style="color:var(--kw-muted); max-width:560px; line-height:1.7;">{{ cms.events.newslettersSection.intro | markdownInline | safe }}</p>
      </div>

      {% for group in collections.newslettersByYear %}
      <div class="reveal" style="margin-bottom:40px;">
        <h3 style="font-size:1.1rem; color:var(--kw-navy); margin-bottom:16px; padding-bottom:10px; border-bottom:2px solid {% if loop.first %}var(--kw-gold){% else %}var(--kw-blue-light){% endif %}; display:inline-block;">{{ group.year }}</h3>
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:10px;">
          {% for nl in group.items %}
          <a href="{{ nl.data.pdfUrl }}" target="_blank" rel="noopener noreferrer" class="nl-card">
            <div class="nl-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <div>
              <p style="font-family:var(--font-display); font-weight:600; font-size:0.9rem; margin-bottom:2px;">{{ nl.data.title }}</p>
              <p style="font-size:0.78rem; color:var(--kw-muted);">PDF · Download</p>
            </div>
          </a>
          {% endfor %}
        </div>
      </div>
      {% endfor %}

      <!-- Older Archive Notice -->
      <div class="reveal" style="background:white; border-radius:14px; border:1px solid var(--kw-border); padding:24px 28px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
        <div>
          <p style="font-family:var(--font-display); font-weight:700; margin-bottom:4px; color:var(--kw-dark);">2021 – 2024 Archive</p>
          <p style="font-size:0.875rem; color:var(--kw-muted);">The full newsletter archive from 2021 through 2024 is available on the original Kiwanis website.</p>
        </div>
        <a href="https://winvakiw.org/newsletters/" target="_blank" rel="noopener noreferrer" class="btn btn-outline-blue btn-sm">View Full Archive</a>
      </div>
    </div>
  </section>
