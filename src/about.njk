---
layout: base.njk
title: "About Our Club"
description: "Learn about the Kiwanis Club of Winchester, Virginia — chartered in 1922 and dedicated to serving children and families."
canonical: /about/
navActive: about
---

  <!-- Page Hero -->
  <div class="page-hero" style="--page-hero-image:url('{{ cms.about.hero.image }}'); --page-hero-position:{{ cms.about.hero.position }};">
    <div class="kw-container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span style="color:rgba(255,255,255,0.9);">About</span>
      </nav>
      <h1>{{ cms.about.hero.title }}</h1>
      <p class="hero-sub">{{ cms.about.hero.subtitle | markdownInline | safe }}</p>
    </div>
  </div>

  <!-- ── CLUB OVERVIEW ── -->
  <section class="section" aria-labelledby="overview-heading">
    <div class="kw-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
        <div class="reveal">
          <span class="tag tag-blue" style="margin-bottom:16px; display:inline-flex;">{{ cms.about.overview.eyebrow }}</span>
          <h2 id="overview-heading" class="section-title">{{ cms.about.overview.title }}</h2>
          <div class="divider-gold"></div>
          <p style="font-size:1.05rem; color:var(--kw-muted); line-height:1.75; margin-bottom:18px;">
            {{ cms.about.overview.body1 | markdownInline | safe }}
          </p>
          <p style="color:var(--kw-muted); line-height:1.75; margin-bottom:18px;">
            {{ cms.about.overview.body2 | markdownInline | safe }}
          </p>
          <p style="color:var(--kw-muted); line-height:1.75; margin-bottom:32px;">
            {{ cms.about.overview.body3 | markdownInline | safe }}
          </p>

          <!-- Meeting Details Card -->
          <div style="background:var(--kw-blue-light); border-radius:14px; padding:24px; display:flex; gap:16px; align-items:flex-start;">
            <div style="width:44px; height:44px; background:var(--kw-blue); border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div>
              <p style="font-family:var(--font-display); font-weight:700; color:var(--kw-blue); margin-bottom:4px;">Weekly Meetings</p>
              <p style="font-size:0.9rem; color:var(--kw-navy);">Every Wednesday at noon<br>Winchester Moose Club, 215 E. Cork St., Winchester, VA</p>
            </div>
          </div>
        </div>

        <div class="reveal reveal-d2" style="border-radius:20px; overflow:hidden; aspect-ratio:4/3; background:var(--kw-light);">
          <img src="{{ cms.about.overview.image }}"
               alt="{{ cms.about.overview.imageAlt }}"
               class="img-cover"
               loading="lazy">
        </div>
      </div>
    </div>
  </section>

  <!-- ── MISSION & VISION ── -->
  <section class="section bg-light" aria-labelledby="mission-heading">
    <div class="kw-container">
      <div class="section-header text-center reveal" style="max-width:640px; margin:0 auto 56px;">
        <span class="tag tag-blue" style="margin:0 auto 12px; display:inline-flex;">Purpose</span>
        <h2 id="mission-heading" class="section-title">Mission &amp; Vision</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="reveal" style="background:white; border-radius:var(--radius-card); padding:40px; border:1px solid var(--kw-border);">
          <div style="width:52px; height:52px; background:var(--kw-blue-light); border-radius:13px; display:flex; align-items:center; justify-content:center; margin-bottom:20px; color:var(--kw-blue);">
            <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <h3 style="font-size:1.3rem; margin-bottom:14px;">Our Mission</h3>
          <p style="color:var(--kw-muted); line-height:1.75; font-size:1rem;">
            Kiwanis is a global organization of volunteers dedicated to improving the world one child and one community at a time. Our Winchester chapter lives this mission through hands-on service every week of the year.
          </p>
        </div>

        <div class="reveal reveal-d2" style="background:var(--kw-navy); border-radius:var(--radius-card); padding:40px; color:white;">
          <div style="width:52px; height:52px; background:rgba(255,209,0,0.2); border-radius:13px; display:flex; align-items:center; justify-content:center; margin-bottom:20px; color:var(--kw-gold);">
