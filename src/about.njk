{% block pageScripts %}
<script>
  // ── Presidents Timeline + Lightbox ──
  (function() {
    var track = document.getElementById('pres-track');
    if (!track) return;

    var cards = Array.from(track.querySelectorAll('.pres-card'));
    var dots  = Array.from(document.querySelectorAll('.pres-tl-dot'));
    var cardW = 220 + 14; // card flex-basis + gap

    // Build image data
    var images = cards.map(function(c) {
      var img = c.querySelector('img');
      return { src: img ? img.src : '', alt: img ? img.alt : '', decade: c.getAttribute('data-decade') || '' };
    });

    // ── Drag scroll ──
    var dragging = false, startX = 0, scrollStart = 0, hasDragged = false;
    track.addEventListener('mousedown', function(e) {
      dragging = true; hasDragged = false;
      track.classList.add('is-dragging');
      startX = e.pageX; scrollStart = track.scrollLeft;
    });
    document.addEventListener('mouseup', function() { dragging = false; track.classList.remove('is-dragging'); });
    track.addEventListener('mousemove', function(e) {
      if (!dragging) return;
      e.preventDefault();
      var dx = e.pageX - startX;
      if (Math.abs(dx) > 5) hasDragged = true;
      track.scrollLeft = scrollStart - dx;
    });

    // ── Arrow nav ──
    document.getElementById('pres-prev').addEventListener('click', function() {
      track.scrollBy({ left: -cardW, behavior: 'smooth' });
    });
    document.getElementById('pres-next').addEventListener('click', function() {
      track.scrollBy({ left: cardW, behavior: 'smooth' });
    });

    // ── Dot sync on scroll ──
    function getActiveIdx() {
      return Math.min(Math.round(track.scrollLeft / cardW), cards.length - 1);
    }
    function syncDots(idx) {
      dots.forEach(function(d, i) { d.classList.toggle('pres-tl-dot--active', i === idx); });
    }
    track.addEventListener('scroll', function() { syncDots(getActiveIdx()); }, { passive: true });

    // ── Dot click → scroll ──
    dots.forEach(function(dot, i) {
      dot.addEventListener('click', function() {
        track.scrollTo({ left: i * cardW, behavior: 'smooth' });
      });
    });

    // ── Lightbox ──
    var lb = document.createElement('div');
    lb.id = 'kw-lightbox';
    lb.setAttribute('role', 'dialog');
    lb.setAttribute('aria-modal', 'true');
    lb.setAttribute('aria-label', 'Photo viewer');
    lb.style.cssText = 'display:none;position:fixed;inset:0;z-index:9000;background:rgba(0,10,40,0.95);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);align-items:center;justify-content:center;';
    lb.innerHTML = [
      '<button id="lb-close" aria-label="Close" style="position:absolute;top:20px;right:24px;background:rgba(255,255,255,0.12);border:none;border-radius:50%;width:44px;height:44px;cursor:pointer;color:white;display:flex;align-items:center;justify-content:center;">',
        '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>',
      '</button>',
      '<button id="lb-prev" aria-label="Previous decade" style="position:absolute;left:16px;top:50%;transform:translateY(-50%);background:rgba(255,255,255,0.12);border:none;border-radius:50%;width:52px;height:52px;cursor:pointer;color:white;display:flex;align-items:center;justify-content:center;">',
        '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>',
      '</button>',
      '<div style="max-width:min(90vw,900px);display:flex;flex-direction:column;align-items:center;gap:16px;">',
        '<div id="lb-label" style="font-family:\'Plus Jakarta Sans\',sans-serif;font-weight:800;font-size:0.85rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--kw-gold);"></div>',
        '<img id="lb-img" src="" alt="" style="max-width:100%;max-height:78vh;border-radius:16px;box-shadow:0 40px 100px rgba(0,0,0,0.6);object-fit:contain;">',
        '<p id="lb-counter" style="color:rgba(255,255,255,0.45);font-size:0.8rem;"></p>',
      '</div>',
      '<button id="lb-next" aria-label="Next decade" style="position:absolute;right:16px;top:50%;transform:translateY(-50%);background:rgba(255,255,255,0.12);border:none;border-radius:50%;width:52px;height:52px;cursor:pointer;color:white;display:flex;align-items:center;justify-content:center;">',
        '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>',
      '</button>',
    ].join('');
    document.body.appendChild(lb);
    var cur = 0;
    function openLb(i) {
      cur = i; renderLb(); lb.style.display = 'flex'; document.body.style.overflow = 'hidden';
      document.getElementById('lb-close').focus();
    }
    function closeLb() { lb.style.display = 'none'; document.body.style.overflow = ''; }
    function renderLb() {
      var d = images[cur] || {};
      document.getElementById('lb-img').src = d.src || '';
      document.getElementById('lb-img').alt = d.alt || '';
      document.getElementById('lb-label').textContent = d.decade || '';
      document.getElementById('lb-counter').textContent = (cur + 1) + ' of ' + images.length;
    }
    document.getElementById('lb-close').addEventListener('click', closeLb);
    document.getElementById('lb-prev').addEventListener('click', function() { cur = (cur - 1 + images.length) % images.length; renderLb(); });
    document.getElementById('lb-next').addEventListener('click', function() { cur = (cur + 1) % images.length; renderLb(); });
    lb.addEventListener('click', function(e) { if (e.target === lb) closeLb(); });
    document.addEventListener('keydown', function(e) {
      if (lb.style.display === 'none') return;
      if (e.key === 'Escape') closeLb();
      if (e.key === 'ArrowLeft') { cur = (cur - 1 + images.length) % images.length; renderLb(); }
      if (e.key === 'ArrowRight') { cur = (cur + 1) % images.length; renderLb(); }
    });

    // Card click → lightbox (only if not dragging)
    cards.forEach(function(card, i) {
      card.addEventListener('click', function() { if (!hasDragged) openLb(i); });
      card.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLb(i); }
      });
    });
  })();
</script>
{% endblock %}
