<!-- ═══ FOOTER ═══ -->
<footer id="site-footer" aria-label="Site footer">
  <div class="kw-container">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10" style="margin-bottom:0;">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/" class="footer-logo-link" aria-label="Kiwanis Club of Winchester — Home">
          <div class="nav-logo-lockup footer-logo-lockup">
            <img src="/assets/uploads/2023/03/kiwanis-seal.png" alt="" class="nav-seal" aria-hidden="true">
            <div class="nav-logo-text">
              <span class="nav-wordmark">Kiwanis</span>
              <span class="nav-clubname">Club of Winchester</span>
            </div>
          </div>
        </a>
        <p class="footer-text" style="max-width:360px; margin-bottom:24px;">
          The Kiwanis Club of Winchester, Virginia — a nonprofit service club chartered in 1922, dedicated to changing the world one child and one community at a time.
        </p>
        <a href="{{ site.facebook }}" target="_blank" rel="noopener noreferrer"
           class="footer-link" style="display:inline-flex; align-items:center; gap:8px; font-weight:600;">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          Facebook — {{ site.facebookHandle }}
        </a>
      </div>

      <!-- Navigate -->
      <div>
        <h3 class="footer-col-title">Navigate</h3>
        <nav aria-label="Footer navigation">
          <a href="/" class="footer-link">Home</a>
          <a href="/about/" class="footer-link">About Us</a>
          <a href="/what-we-do/" class="footer-link">What We Do</a>
          <a href="/youth-programs/" class="footer-link">Youth Programs</a>
          <a href="/pancake-day/" class="footer-link">Pancake Day</a>
          <a href="/events/" class="footer-link">Events &amp; News</a>
          <a href="/resources/" class="footer-link">Resources</a>
          <a href="/join/" class="footer-link">Join Us</a>
          <a href="/contact/" class="footer-link">Contact</a>
        </nav>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="footer-col-title">Contact</h3>
        <div class="footer-text">
          <p style="margin-bottom:10px;">
            <a href="mailto:{{ site.email }}" class="footer-link" style="display:inline;">{{ site.email }}</a>
          </p>
          <p style="margin-bottom:14px;">{{ site.address.po_box }}<br>{{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}</p>
          <p style="font-family:var(--font-display); font-weight:600; color:rgba(255,255,255,0.8); font-size:0.875rem; margin-bottom:6px;">Weekly Meetings</p>
          <p>{{ site.meetings.day }} at {{ site.meetings.time }}<br>{{ site.meetings.location }}<br>{{ site.meetings.street }}</p>
        </div>
      </div>
    </div>

    <hr class="footer-divider">

    <div style="display:flex; flex-direction:column; gap:8px; align-items:center; text-align:center;">
      <p style="color:rgba(255,255,255,0.35); font-size:0.85rem;">&copy; {{ site.name }}. All rights reserved.</p>
      <p style="color:rgba(255,255,255,0.22); font-size:0.8rem;">Part of Kiwanis International &bull; WIN-VA District</p>
    </div>
  </div>
</footer>
